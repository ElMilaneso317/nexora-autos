# Node.js 22.18 o posterior. Copia este archivo como .env si falta.
PORT=3000

# Vacío: el servidor genera una firma aleatoria en cada arranque.
# Puedes definir un valor aleatorio privado; no publiques tu archivo .env.
SESSION_SECRET=

# Ruta relativa a la raíz del proyecto o ruta absoluta.
NEXORA_DB_PATH=data/nexora.sqlite
