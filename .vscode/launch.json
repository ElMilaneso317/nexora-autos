{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nexora: backend (F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--env-file-if-exists=.env"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Nexora: frontend (Edge con servidor iniciado)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Nexora: pruebas de API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/integration.test.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
